# Environment Variables (копируйте в .env)

# AnyModel.org (генерация изображений) — https://anymodel.org/app/keys
ANYMODEL_API_KEY=your-anymodel-key

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your-bot-token

# Telegram Channel
CHANNEL_USERNAME=@stroitelinfo

# Database URL (SQLite для локальной разработки)
DATABASE_URL=sqlite:///./dekorinfo.db

# Backend URL
VITE_API_URL=http://localhost:8000

# Webhook URL (для Railway деплоя)
WEBHOOK_URL=https://your-app.railway.app/api/telegram-webhook

# Secret Key (сгенерируйте свой!)
SECRET_KEY=your-secret-key-change-this-in-production

# Environment
NODE_ENV=development
